# Discord Bot Token (Lấy từ Discord Developer Portal -> Applications -> ap efficiency -> Bot -> Reset Token)
DISCORD_BOT_TOKEN=

# Google Gemini API Key (Lấy từ https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Model Gemini sử dụng (Mặc định: gemini-2.5-flash hoặc gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-2.5-flash

# Discord Client ID của ứng dụng
DISCORD_CLIENT_ID=1563924967996002406
